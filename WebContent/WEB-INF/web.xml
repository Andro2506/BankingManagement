<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>BankingManagement</display-name>

  <!-- Welcome page is index.jsp -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Listener that creates tables and seeds demo data on startup -->
  <listener>
    <listener-class>com.bank.util.DatabaseInitializer</listener-class>
  </listener>

  <!-- ===================== Employee UI ===================== -->

  <servlet>
    <servlet-name>EmployeeRegister</servlet-name>
    <servlet-class>com.bank.servlet.EmployeeRegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EmployeeRegister</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>EmployeeLogin</servlet-name>
    <servlet-class>com.bank.servlet.EmployeeLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EmployeeLogin</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>EmployeeLogout</servlet-name>
    <servlet-class>com.bank.servlet.EmployeeLogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EmployeeLogout</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- Manager-only employee management -->
  <servlet>
    <servlet-name>EmployeeList</servlet-name>
    <servlet-class>com.bank.servlet.EmployeeListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EmployeeList</servlet-name>
    <url-pattern>/employees</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>EmployeeEditDesignation</servlet-name>
    <servlet-class>com.bank.servlet.EmployeeEditDesignationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EmployeeEditDesignation</servlet-name>
    <url-pattern>/employee/edit-designation</url-pattern>
  </servlet-mapping>

  <!-- ===================== Customer UI ===================== -->

  <servlet>
    <servlet-name>CustomerRegister</servlet-name>
    <servlet-class>com.bank.servlet.CustomerRegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerRegister</servlet-name>
    <url-pattern>/customer/register</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerList</servlet-name>
    <servlet-class>com.bank.servlet.CustomerListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerList</servlet-name>
    <url-pattern>/customers</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerEdit</servlet-name>
    <servlet-class>com.bank.servlet.CustomerEditServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerEdit</servlet-name>
    <url-pattern>/customer/edit</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerDelete</servlet-name>
    <servlet-class>com.bank.servlet.CustomerDeleteServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerDelete</servlet-name>
    <url-pattern>/customer/delete</url-pattern>
  </servlet-mapping>

  <!-- ===================== Transactions ===================== -->

  <servlet>
    <servlet-name>Transaction</servlet-name>
    <servlet-class>com.bank.servlet.TransactionServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Transaction</servlet-name>
    <url-pattern>/transaction</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>TransactionList</servlet-name>
    <servlet-class>com.bank.servlet.TransactionListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>TransactionList</servlet-name>
    <url-pattern>/transactions</url-pattern>
  </servlet-mapping>

  <!-- ===================== Loans ===================== -->

  <servlet>
    <servlet-name>Loan</servlet-name>
    <servlet-class>com.bank.servlet.LoanServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Loan</servlet-name>
    <url-pattern>/loan</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoanList</servlet-name>
    <servlet-class>com.bank.servlet.LoanListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoanList</servlet-name>
    <url-pattern>/loans</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoanEdit</servlet-name>
    <servlet-class>com.bank.servlet.LoanEditServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoanEdit</servlet-name>
    <url-pattern>/loan/edit</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoanDelete</servlet-name>
    <servlet-class>com.bank.servlet.LoanDeleteServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoanDelete</servlet-name>
    <url-pattern>/loan/delete</url-pattern>
  </servlet-mapping>

  <!-- ===================== Additional Servlet/JSP modules ===================== -->

  <servlet>
    <servlet-name>NetBankingLogin</servlet-name>
    <servlet-class>com.bank.servlet.NetBankingLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>NetBankingLogin</servlet-name>
    <url-pattern>/netbankingLogin</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerLogin</servlet-name>
    <servlet-class>com.bank.servlet.CustomerLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerLogin</servlet-name>
    <url-pattern>/customerLogin</url-pattern>
  </servlet-mapping>

  <!-- ===================== Customer Portal (post-login) ===================== -->

  <servlet>
    <servlet-name>CustomerLogout</servlet-name>
    <servlet-class>com.bank.servlet.CustomerLogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerLogout</servlet-name>
    <url-pattern>/customer/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerTransaction</servlet-name>
    <servlet-class>com.bank.servlet.CustomerTransactionServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerTransaction</servlet-name>
    <url-pattern>/customer/transaction</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerLoan</servlet-name>
    <servlet-class>com.bank.servlet.CustomerLoanServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerLoan</servlet-name>
    <url-pattern>/customer/loan</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerMyTransactions</servlet-name>
    <servlet-class>com.bank.servlet.CustomerMyTransactionsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerMyTransactions</servlet-name>
    <url-pattern>/customer/my-transactions</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CustomerMyLoans</servlet-name>
    <servlet-class>com.bank.servlet.CustomerMyLoansServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerMyLoans</servlet-name>
    <url-pattern>/customer/my-loans</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SimpleCustomer</servlet-name>
    <servlet-class>com.bank.servlet.SimpleCustomerServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SimpleCustomer</servlet-name>
    <url-pattern>/simpleCustomer</url-pattern>
  </servlet-mapping>

  <!-- ===================== Session settings & error page ===================== -->

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/error.jsp</location>
  </error-page>

  <error-page>
    <error-code>404</error-code>
    <location>/error.jsp</location>
  </error-page>

</web-app>
